<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <!-- FBXSDK_DIR falls back to FBX_SDK (set by the game's usagi_env.bat). -->
    <FBXSDK_DIR Condition="'$(FBXSDK_DIR)'=='' and '$(FBX_SDK)'!=''">$(FBX_SDK)</FBXSDK_DIR>
    <!-- FBX SDK 2020.3+ installs lib\x64\{debug,release}; older SDKs use lib\vs2019\x64\{debug,release}. -->
    <FbxSdkLibRoot Condition="Exists('$(FBXSDK_DIR)\lib\x64')">$(FBXSDK_DIR)\lib\x64</FbxSdkLibRoot>
    <FbxSdkLibRoot Condition="'$(FbxSdkLibRoot)'==''">$(FBXSDK_DIR)\lib\vs2019\x64</FbxSdkLibRoot>
    <UsagiLibDir>$(USAGI_DIR)\_libs\$(Platform)\$(Configuration)</UsagiLibDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(USAGI_DIR);$(USAGI_DIR)\_build\proto;$(USAGI_DIR)\Engine\ThirdParty\nanopb;$(USAGI_DIR)\Engine\ThirdParty\lua-5.3.2\src</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>LUA_USER_H=&lt;Engine/Framework/Script/LuaConf.h&gt;;PB_FIELD_32BIT;NN_SWITCH_ENABLE_HOST_IO;TOOL_BUILD;PLATFORM_PC;_CRT_SECURE_NO_WARNINGS;_SCL_SECURE_NO_WARNINGS</PreprocessorDefinitions>
      <DisableSpecificWarnings>4291</DisableSpecificWarnings>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup />
</Project>